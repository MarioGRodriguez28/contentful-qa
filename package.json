{
  "name": "contentful-qa",
  "version": "0.1.0",
  "private": true,
  "description": "Personal learning project: API, GraphQL and UI tests against a Contentful space",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --dir test",
    "seed": "tsx scripts/seed.ts",
    "test:api": "vitest run --dir tests/api --reporter=default --reporter=junit --outputFile.junit=reports/api-junit.xml",
    "test:postman": "tsx scripts/run-newman.ts",
    "test:graphql": "vitest run --dir tests/graphql --reporter=default --reporter=junit --outputFile.junit=reports/graphql-junit.xml",
    "serve:web": "tsx scripts/serve-web.ts",
    "test:ui": "playwright test",
    "test:all": "npm run test:unit && npm run test:api && npm run test:postman && npm run test:graphql && npm run test:ui"
  },
  "author": "Mario Rodr\u00edguez",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "newman": "^6.2.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "dotenv": "^18.0.9"
  }
}
